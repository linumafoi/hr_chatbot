# ============================================================
#  HR AI Chatbot - Environment Configuration
#  Copy to ".env" and adjust to your local setup.
# ============================================================

# ---------------- App ----------------
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated list of allowed CORS origins for the UI
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------- Auth ----------------
# Change this secret in production!
JWT_SECRET=change-me-super-secret-key
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=720
# Common admin login (single shared admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123
# Common password used by employee logins (employee identity comes from employee_id)
EMPLOYEE_PASSWORD=employee@123

# ---------------- PostgreSQL (semantic / RAG store: database "chatbot") ----------------
PG_DB=chatbot
PG_USER=postgres
PG_PASSWORD=Mafoi@123
PG_HOST=localhost
PG_PORT=5433

# ---------------- SQL Server (HRMS execution store: database "hrms") ----------------
MSSQL_SERVER=Mounika-7VJMXL3\MSSQLSERVER02
MSSQL_PORT=1433
MSSQL_DATABASE=hrms
MSSQL_USERNAME=sa
MSSQL_PASSWORD=mafoi@123
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# Tables the SQL agent is allowed to read (comma separated, allow-list)
MSSQL_ALLOWED_TABLES=employees,EmployeeEmployment

# ---------------- Redis (conversation memory) ----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CONVERSATION_TTL_SECONDS=86400

# ---------------- LLM endpoints (Ollama) ----------------
# Ollama serves the OpenAI-compatible API at /v1. Start it with `ollama serve`.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Ollama model tags. Pull them first, e.g. `ollama pull qwen3:8b`
# Sized for 8GB GPU + 16GB RAM. One shared qwen3:8b for all qwen roles keeps a
# single model resident (lowest latency). deepseek-r1:7b for NL->SQL fits 8GB.
INTENT_MODEL=qwen3:8b
REWRITE_MODEL=qwen3:8b
SQL_VALIDATION_MODEL=qwen3:8b
SQL_GEN_MODEL=deepseek-r1:7b
CHAT_MODEL=qwen3:8b
ANSWER_MODEL=qwen3:8b

# Embeddings (BGE-M3) via Ollama OpenAI-compatible /v1/embeddings
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3

# Reranker. Ollama has no native rerank API:
#   RERANK_MODE=llm  -> one listwise pass with RERANK_MODEL (works on Ollama)
#   RERANK_MODE=http -> dedicated cross-encoder server (vLLM/TEI) at RERANK_BASE_URL
RERANK_MODE=llm
RERANK_BASE_URL=http://localhost:11434/v1
RERANK_API_KEY=ollama
RERANK_MODEL=qwen3:8b

# ---------------- Pipeline tuning ----------------
RAG_TOP_K=20
RAG_RERANK_K=5
SQL_MAX_ROWS=100
REQUEST_TIMEOUT_SECONDS=60
# If true, the system runs even when models/DBs are unreachable (returns graceful fallbacks)
GRACEFUL_FALLBACK=true
